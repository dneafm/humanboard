# GEMMA_BASE_URL: OpenAI-compatible local endpoint for Gemma live.
# Example: Ollama with OpenAI compatibility or another local serving layer.
GEMMA_BASE_URL="http://127.0.0.1:11434/v1"

# GEMMA_MODEL: Default live Gemma model HumanBoard should use.
GEMMA_MODEL="gemma4:26b"

# GEMMA_API_KEY: Optional for OpenAI-compatible servers that require a bearer token.
GEMMA_API_KEY="not-required"

# GEMINI_API_KEY: Optional legacy key kept only for non-Gemma features like current TTS/image flows if still enabled.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
