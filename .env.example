# AI runtime: any OpenAI-compatible local model server or hosted API.
# Examples:
# - Ollama via OpenAI compatibility
# - LM Studio local server
# - vLLM / llama.cpp server
# - OpenRouter / Together / custom OpenAI-compatible gateway
AI_BASE_URL="http://127.0.0.1:11434/v1"

# Default model name to call on that endpoint.
AI_MODEL="gemma4:26b"

# Optional bearer token for OpenAI-compatible servers that require auth.
AI_API_KEY="***"

# Optional legacy key kept only for any separate non-chat features if still enabled.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
