# AI runtime: any OpenAI-compatible local model server or hosted API.
# Examples:
# - Ollama via OpenAI compatibility
# - LM Studio local server
# - vLLM / llama.cpp server
# - OpenRouter / Together / custom OpenAI-compatible gateway
AI_BASE_URL="http://127.0.0.1:11434/v1"

# Default model name to call on that endpoint.
AI_MODEL="gemma4:26b"

# Vision-capable OpenAI-compatible model used to turn uploaded images into notes.
VITE_IMAGE_ANALYSIS_MODEL="gpt-4o-mini"

# Optional bearer token for OpenAI-compatible servers that require auth.
AI_API_KEY="***"

# Optional legacy key kept only for any separate non-chat features if still enabled.
GEMINI_API_KEY="***"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Frontend API base URL. Leave blank for same-origin local/prod serving.
# For Tailscale Funnel, set this to the Funnel origin, for example:
# VITE_API_URL="https://your-device.tailnet-name.ts.net"
VITE_API_URL=""

# Firebase Web App config for Google Auth.
VITE_FIREBASE_API_KEY="***"
VITE_FIREBASE_AUTH_DOMAIN="humanboard-alpha-123.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="humanboard-alpha-123"
VITE_FIREBASE_STORAGE_BUCKET="humanboard-alpha-123.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="***"
VITE_FIREBASE_APP_ID="***"
VITE_FIREBASE_MEASUREMENT_ID=""

# Keep disabled for alpha testers unless you intentionally want to import
# local AI-era KB artifacts into the signed-in user's HumanBoard snapshot.
VITE_ENABLE_AI_ERA_KB_BRIDGE="false"
